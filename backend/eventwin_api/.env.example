DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=eventwin
DB_USER=eventwin
DB_PASSWORD=eventwin
DB_HOST=localhost
DB_PORT=5432

# --- Analyse budgétaire par IA locale (Ollama) ---
# Lancez le serveur avec `ollama serve` puis `ollama pull llama3.2:3b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
# Ressources envoyées par appel IA (un seul lot par analyse). Un lot trop gros
# peut faire « oublier » des ressources au modèle : ajustez selon votre machine.
OLLAMA_BATCH_SIZE=20
# Délai global d'une analyse (secondes) au-delà duquel le reste part en tâche
# de fond, et durée de vie du verrou anti-double-analyse d'un même événement.
BUDGET_ANALYSIS_TIMEOUT=120
BUDGET_ANALYSIS_LOCK_TTL=600

# --- Recherche web réelle de fournisseurs (optionnel) ---
# Sans aucune clé, le module effectue quand même une VRAIE recherche web via
# Bing (région France) : les liens affichés sont de vraies pages produits,
# jamais inventés. Comme aucun tarif n'est alors relevé sur la page, le prix
# reste une estimation IA et jamais le prix du fournisseur.
#
# Si vous configurez une clé API ci-dessous, le module l'utilise en priorité et
# peut remonter des prix réellement relevés (price_source = "real_offer").
BRAVE_SEARCH_API_KEY=
SERP_API_KEY=

# Garde-fous de la recherche (valeurs par défaut, surchargeables).
# MAX_SEARCHES        : recherches maximum par analyse ;
# MAX_RESULTS         : résultats retenus par recherche ;
# PROMPT_CANDIDATES   : candidats réellement montrés au modèle (indices bornés) ;
# CONCURRENCE/TIMEOUT : parallélisme et délai réseau ;
# BLOCKED_DOMAINS     : encyclopédies, dictionnaires, réseaux sociaux exclus.
WEB_SEARCH_MAX_SEARCHES=8
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_PROMPT_CANDIDATES=3
WEB_SEARCH_CONCURRENCY=4
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_CACHE_TTL=900
# Ne mettez cette ligne que pour AJOUTER des domaines exclus (séparés par des
# virgules). Laissée vide, elle désactiverait la liste par défaut : laissez-la
# commentée pour conserver les encyclopédies/dictionnaires/réseaux sociaux.
# WEB_SEARCH_BLOCKED_DOMAINS=

# Anciennes variables conservées pour compatibilité.
WEB_SEARCH_AVAILABLE=false
WEB_SEARCH_API_KEY=
