# ============================================================================
# EventWIN — Configuration
# ----------------------------------------------------------------------------
# ATTENTION — Rôle des deux fichiers :
#   • `.env`         = vos VRAIES valeurs. Il est GITIGNORÉ (jamais commité).
#   • `.env.example` = ce même gabarit. Il est COMMITÉ et visible de tous.
# Ces deux fichiers sont ici identiques et ne contiennent QUE des valeurs de
# développement ou des substituts vides. Dès qu'une vraie clé secrète apparaît
# (SECRET_KEY, mot de passe DB, SMTP, clés API), elle va UNIQUEMENT dans
# `.env` ; `.env.example` conserve le substitut vide — sinon le secret serait
# versionné.
# ============================================================================

# --- Django ------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (PostgreSQL) --------------------------------------------
DB_NAME=eventwin
DB_USER=eventwin
DB_PASSWORD=eventwin
DB_HOST=localhost
DB_PORT=5432

# --- E-mail (invitations + réinitialisation de mot de passe) -----------------
# SMTP non configuré pour l'instant : les envois échouent et l'application
# l'indique honnêtement (email_sent=False + raison). Renseignez
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD pour activer l'envoi réel.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# URL publique du front : sert à construire les liens d'activation et de
# réinitialisation envoyés par e-mail.
FRONTEND_BASE_URL=http://localhost:4200
# Durée de validité des jetons (heures).
AUTH_TOKEN_TTL_HOURS=48
INVITATION_TTL_HOURS=168

# --- Analyse budgétaire IA (Google Gemini) ------------------------------------
# La clé va UNIQUEMENT dans `.env` (jamais ici). Elle reste commentée dans ce
# gabarit : une ligne vide « GEMINI_API_KEY= » masquerait la vraie clé sous
# Docker (ce fichier y est chargé en premier).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Repli automatique si le modèle principal est à court de quota ou surchargé.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash
GEMINI_TIMEOUT=180
GEMINI_TEMPERATURE=0.4
# Ressources envoyées par appel IA (un seul lot par analyse). Un lot trop gros
# peut faire « oublier » des ressources au modèle : ajustez si besoin.
AI_BATCH_SIZE=20
# Devise d'affichage du budget (vide = aucun symbole imposé).
BUDGET_CURRENCY=
# Délai global d'une analyse (secondes) au-delà duquel le reste part en tâche
# de fond, et durée de vie du verrou anti-double-analyse d'un même événement.
BUDGET_ANALYSIS_TIMEOUT=120
BUDGET_ANALYSIS_LOCK_TTL=600

# --- Recherche web réelle de fournisseurs (optionnel) ------------------------
# Sans aucune clé, le module effectue une VRAIE recherche sans clé via Bing
# (région France) : les liens sont de vraies pages produits, jamais inventés.
# Aucun tarif n'est alors relevé sur la page : le prix reste une estimation IA
# et jamais le prix du fournisseur.
# Avec une clé API ci-dessous, le module l'utilise en priorité et peut remonter
# des prix réellement relevés (price_source = "real_offer").
BRAVE_SEARCH_API_KEY=
SERP_API_KEY=

# Garde-fous de la recherche (valeurs par défaut, surchargeables).
# MAX_SEARCHES        : recherches maximum par analyse ;
# MAX_RESULTS         : résultats retenus par recherche ;
# PROMPT_CANDIDATES   : candidats réellement montrés au modèle ;
# CONCURRENCE/TIMEOUT : parallélisme et délai réseau ;
# BLOCKED_DOMAINS     : encyclopédies, dictionnaires, réseaux sociaux exclus.
WEB_SEARCH_MAX_SEARCHES=8
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_PROMPT_CANDIDATES=3
WEB_SEARCH_CONCURRENCY=4
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_CACHE_TTL=900
WEB_SEARCH_USER_AGENT=EventWIN/1.0 (+https://eventwin.local; budget-check)
# Ne décommentez cette ligne que pour AJOUTER des domaines exclus (séparés par
# des virgules). Laissée vide, elle désactiverait la liste par défaut :
# laissez-la commentée pour conserver les encyclopédies/réseaux sociaux.
# WEB_SEARCH_BLOCKED_DOMAINS=

# --- Anciennes variables conservées pour compatibilité -----------------------
WEB_SEARCH_AVAILABLE=false
WEB_SEARCH_API_KEY=
# Module sponsors (tous optionnels)
SPONSORS_AI_ENABLED=false
SPONSORS_WEBHOOK_URL=
SPONSORS_PORTAL_TTL_DAYS=30
SPONSORS_PORTAL_BASE_URL=http://localhost:4200
